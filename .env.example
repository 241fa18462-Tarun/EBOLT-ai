# Backend provider key. Keep this only on the server; never expose it as a VITE_ variable.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Optional: URL of the deployed Express backend, needed when the frontend is hosted separately.
# Leave blank when the frontend and backend are served by the same Node.js app.
VITE_API_BASE_URL="https://YOUR-BACKEND.onrender.com"

# Optional deployment URL
APP_URL="https://YOUR-APP-URL"
